{
  "name": "omnitraf-command-center",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "build": "vite build && node scripts/hash-public-assets.mjs && node scripts/report-build-size.mjs",
    "preview": "vite preview",
    "validate": "node scripts/validate-pwa.mjs",
    "lint": "node scripts/run-lint.mjs",
    "lint:css": "node scripts/lint-css.mjs",
    "start": "node server.js",
    "test": "node scripts/run-tests.mjs",
    "test:postgres": "node --test test/postgres/*.test.js",
    "test:cluster": "node --test test/cluster/leadership_failover.test.js",
    "backup:postgres": "node scripts/backup-postgres.mjs",
    "verify:postgres-backup": "node scripts/verify-postgres-backup.mjs",
    "db:migrate:sqljs-to-postgres": "node scripts/migrate-sqljs-to-postgres.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.js",
    "test:e2e:visual": "playwright test tests/e2e/visual.spec.js",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.4",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "vite": "^8.3.3"
  }
}
