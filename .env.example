# ==============================================================================
# OmniTRAF Surabaya Command Center — Environment Configuration Template
# ==============================================================================

# Node Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Runtime coordination: single runs local simulation; cluster requires REDIS_URL.
OMNITRAF_RUNTIME_MODE=single

# Durable database selection. sqljs is the development/test/single-instance fallback.
DB_DRIVER=sqljs
# DB_DRIVER=postgres requires DATABASE_URL; use PostgreSQL for production clusters.
# DATABASE_URL=postgresql://omnitraf:change-me@localhost:5432/omnitraf
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
# DB_SSL=true enables certificate-verified TLS for PostgreSQL.
DB_SSL=false

# Port server HTTP & WebSocket
PORT=3000
# Optional public CARTO basemap key (Vite exposes this value to the browser).
# When unset, the map uses interactive OpenStreetMap raster tiles.
# VITE_CARTO_BASEMAP_KEY=
# Persistent SQLite-compatible database file. Use an absolute path in production.
DB_PATH=./data/omnitraf.sqlite
# Host binding. Development defaults to loopback; set 0.0.0.0 only when network access is needed.
# Production defaults to 0.0.0.0 for container hosting.
# HOST=127.0.0.1

# Reverse proxy peer IPs allowed to supply X-Forwarded-For (exact IPs, comma-separated).
# Leave empty unless the app is reached only through the listed trusted proxies.
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# Daftar origin yang diizinkan untuk CORS (pisahkan dengan koma).
# Production WAJIB mencantumkan origin eksplisit dan DILARANG menggunakan '*'
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Kunci rahasia untuk penandatanganan JWT token (HS256).
# Di PRODUCTION, JWT_SECRET WAJIB diganti dengan secret unik minimal 32 karakter.
JWT_SECRET=omnitraf-surabaya-jwt-secret-key-2026-secure

# Development convenience auto-login flag.
# Di PRODUCTION, nilai ini otomatis diabaikan (FAIL-CLOSED: false).
DEV_AUTO_LOGIN=false

# Kredensial Administrator untuk Production (Bcrypt Hash):
# ADMIN_USERNAME=admin_sits_surabaya
# ADMIN_PASSWORD_HASH=$2a$10$YourCustomProductionBcryptHashHere...

# Opsional: URL koneksi Redis untuk klaster horizontal multi-instance (@socket.io/redis-adapter)
# REDIS_URL=redis://localhost:6379

# Development-only credentials used by the optional Compose PostgreSQL service.
# POSTGRES_DB=omnitraf
# POSTGRES_USER=omnitraf
# POSTGRES_PASSWORD=omnitraf-local-dev-only
