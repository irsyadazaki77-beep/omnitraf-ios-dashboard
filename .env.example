# ==============================================================================
# OmniTRAF Surabaya Command Center — Environment Configuration Template
# ==============================================================================

# Port server HTTP & WebSocket
PORT=3000

# Daftar origin yang diizinkan untuk CORS (pisahkan dengan koma untuk multiple origin)
ALLOWED_ORIGINS=http://localhost:3000

# Kunci rahasia untuk penandatanganan JWT token
JWT_SECRET=omnitraf-surabaya-jwt-secret-key-2026-secure

# Opsional: URL koneksi Redis untuk skalabilitas klaster horizontal multi-instance (@socket.io/redis-adapter)
# Jika tidak diset, sistem otomatis menggunakan default in-memory adapter
# REDIS_URL=redis://localhost:6379

